{
  "name": "orc-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun server/start.ts",
    "build": "bun run check:types && vite build",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build:pen-solver": "bun scripts/solver/build.ts",
    "check:pen-solver": "bun scripts/solver/check-solver.ts && bun scripts/solver/check-browser.ts",
    "check:pen-data": "bun scripts/e2e/editor/pen/check-record.ts && bun scripts/e2e/editor/pen/check-commands.ts",
    "check:pen": "bun scripts/e2e/editor/pen/check-editor.ts chrome && bun scripts/e2e/editor/pen/check-layout.ts chrome && bun scripts/e2e/editor/pen/check-source.ts chrome && bun scripts/e2e/editor/pen/check-transforms.ts chrome && bun scripts/e2e/editor/pen/check-lifecycle.ts chrome && bun scripts/e2e/editor/pen/check-interactions.ts && bun scripts/e2e/editor/pen/check-refusals.ts chrome && bun scripts/e2e/editor/pen/check-drawing.ts chrome",
    "check:ts7": "bun scripts/tooling/check-ts7.ts",
    "check:tooling": "bun scripts/tooling/check-tooling.ts",
    "check:browser": "bun scripts/runtime/check-browser.ts",
    "check:browser:chromium": "bun scripts/runtime/check-browser.ts chromium",
    "check:editor": "bun scripts/e2e/editor/check-editor.ts",
    "check:history": "bun scripts/e2e/editor/check-history.ts",
    "check:bundle": "bun scripts/e2e/projects/check-bundle.ts",
    "check:panels": "bun scripts/e2e/editor/check-panels.ts",
    "check:lifecycle": "bun scripts/runtime/check-lifecycle.ts",
    "check:saving": "bun scripts/e2e/projects/check-saving.ts",
    "check:rendering": "bun scripts/e2e/rendering/check-rendering.ts",
    "check:layers": "bun scripts/e2e/editor/check-layers.ts",
    "check:deletion": "bun scripts/e2e/editor/check-deletion.ts",
    "check:preview": "bun scripts/e2e/editor/check-preview.ts",
    "check:boundaries": "bun scripts/e2e/editor/check-boundaries.ts",
    "check:atomic": "bun scripts/e2e/editor/check-atomic.ts",
    "check:movement": "bun scripts/e2e/editor/check-movement.ts",
    "check:clipping": "bun scripts/e2e/editor/check-clipping.ts",
    "check:layout": "bun scripts/e2e/editor/check-layout.ts",
    "check:gap": "bun scripts/e2e/editor/check-gap.ts",
    "check:padding": "bun scripts/e2e/editor/check-padding.ts",
    "check:alignment": "bun scripts/e2e/editor/check-alignment.ts",
    "check:participation": "bun scripts/e2e/editor/check-participation.ts",
    "check:sizing": "bun scripts/e2e/editor/check-sizing.ts",
    "check:nested-placement": "bun scripts/e2e/editor/check-nested-placement.ts",
    "check:intrinsic-sizing": "bun scripts/e2e/editor/check-intrinsic-sizing.ts",
    "check:codebase": "fallow dead-code --format json --quiet --explain",
    "check:health": "fallow health --format json --quiet --explain",
    "check:format": "oxfmt --check src shared server scripts tools/anti-slop/index.ts index.html vite.config.ts oxlint.config.ts tsconfig.json tsconfig.server.json package.json .oxfmtrc.json .fallowrc.json",
    "lint": "oxlint",
    "format": "oxfmt --write src shared server scripts tools/anti-slop/index.ts index.html vite.config.ts oxlint.config.ts tsconfig.json tsconfig.server.json package.json .oxfmtrc.json .fallowrc.json",
    "check:pen-performance": "bun scripts/e2e/editor/pen/check-performance.ts chrome",
    "check:pen-provenance": "bun scripts/solver/check-provenance.ts"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@base-ui/react": "1.8.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/html": "1.3.13",
    "@modelcontextprotocol/server": "2.3.1",
    "ast-types": "0.16.3",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recast": "0.24.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fallow": "3.32.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  },
  "packageManager": "bun@1.4.2"
}
