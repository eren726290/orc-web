{
  "name": "orc-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:types": "tsc --noEmit",
    "check:tooling": "bun scripts/check-tooling.ts",
    "check:browser": "bun scripts/check-browser.ts",
    "check:browser:chromium": "bun scripts/check-browser.ts chromium",
    "check:codebase": "fallow dead-code --format json --quiet --explain",
    "check:health": "fallow health --format json --quiet --explain",
    "check:format": "oxfmt --check src scripts tools/anti-slop/index.ts index.html vite.config.ts oxlint.config.ts tsconfig.json package.json .oxfmtrc.json .fallowrc.json",
    "lint": "oxlint",
    "format": "oxfmt --write src scripts tools/anti-slop/index.ts index.html vite.config.ts oxlint.config.ts tsconfig.json package.json .oxfmtrc.json .fallowrc.json"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@base-ui/react": "1.8.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@modelcontextprotocol/server": "2.3.1",
    "ast-types": "0.16.3",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recast": "0.24.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fallow": "3.32.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  },
  "packageManager": "bun@1.4.2"
}
